# Used by docker-compose.yml. Copy to .env (git-ignored) and change the values.
# Local development defaults are fine for a throwaway setup; never reuse them in production.

POSTGRES_DB=customers
POSTGRES_USER=customers_user
POSTGRES_PASSWORD=change-me

# Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value

# Login for the admin panel
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=change-me
